with "config/lithophane_ada_config.gpr";
project Lithophane_Ada is

   for Source_Dirs use ("src/", "config/");
   for Object_Dir use "obj/" & Lithophane_Ada_Config.Build_Profile;
   for Create_Missing_Dirs use "True";
   for Exec_Dir use "bin";
   for Main use ("lithophane_ada.adb");

   package Compiler is
      for Default_Switches ("Ada") use Lithophane_Ada_Config.Ada_Compiler_Switches;
   end Compiler;

   package Binder is
      for Switches ("Ada") use ("-Es"); --  Symbolic traceback
   end Binder;

   package Install is
      for Artifacts (".") use ("share");
   end Install;

end Lithophane_Ada;
